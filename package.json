{
  "name": "usefultoolhub",
  "version": "1.0.0",
  "description": "A collection of useful tools in one place.",
  "main": "script.js",
  "scripts": {
    "test": "jest --verbose",
    "test:ci": "jest --ci --coverage --verbose"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "*/js/*.js",
      "js/*.js",
      "script.js",
      "!node_modules/**"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^28.1.0"
  }
}
