{
  "name": "usefultoolhub",
  "version": "1.0.0",
  "description": "A collection of useful tools in one place.",
  "main": "script.js",
  "scripts": {
    "dev": "npx --yes serve -l 5500 .",
    "dev:api": "python backend.py",
    "test": "jest --verbose",
    "test:ci": "jest --ci --coverage --verbose",
    "test:build": "jest --ci --silent",
    "test:e2e": "jest tests/deployed-site.test.js --verbose --testPathIgnorePatterns=/node_modules/",
    "verify:converters": "node scripts/verify-converters.mjs",
    "verify:image-editor": "node scripts/verify-image-editor.mjs"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/vendor/",
      "/tests/browser/",
      "deployed-site"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/js/vendor/"
    ],
    "collectCoverageFrom": [
      "*/js/*.js",
      "js/*.js",
      "js/shared/*.js",
      "script.js",
      "!node_modules/**",
      "!js/vendor/**"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@testing-library/jest-dom": "^6.9.1",
    "babel-jest": "^30.4.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.62.1"
  }
}
